# Desenvolvimento local apenas. Nunca reutilizar estas credenciais em produção.
POSTGRES_DB=pulse
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse_local_only
PULSE_DATABASE_URL=postgresql+psycopg://pulse:pulse_local_only@localhost:5432/pulse
PULSE_REDIS_URL=redis://localhost:6379/0
# Set true behind HTTPS in a deployment. Keep false for local HTTP only.
PULSE_COOKIE_SECURE=false
PULSE_SESSION_TTL_SECONDS=28800
PULSE_ALLOWED_ORIGINS=["http://localhost:8080","http://localhost:5173","http://localhost:8000","http://127.0.0.1:8080","http://127.0.0.1:5173","http://127.0.0.1:8000"]

{
  "name": "pulse-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:generate": "node ../scripts/export-contract.mjs && openapi-typescript ../contracts/openapi.json -o src/shared/api/schema.d.ts --default-non-nullable false",
    "api:check": "node ../scripts/export-contract.mjs --check && openapi-typescript ../contracts/openapi.json -o src/shared/api/schema.d.ts --default-non-nullable false --check"
  },
  "dependencies": { "react": "^19.0.0", "react-dom": "^19.0.0", "openapi-fetch": "^0.15.0" },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5",
    "openapi-typescript": "^7.10.0"
  }
}
